# Copy to .env.local. The Supabase values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_

# AI helper: "fake" answers locally and only counts a pretend bill
AI_PROVIDER=fake

NEXT_PUBLIC_SITE_URL=http://localhost:3000
