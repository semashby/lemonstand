# Copy to .env.local. The Supabase values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: the secret key (sb_secret_...). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Stripe test mode keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
# Restricted key for the dashboard's refunds: Checkout Sessions read, Refunds write
STRIPE_REFUND_KEY=rk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_

# AI helper: "fake" answers locally and only counts a pretend bill.
# Any other provider needs AI_API_KEY; without it the helper refuses to run.
AI_PROVIDER=fake

# Where alerts go. A topic at ntfy.sh works: https://ntfy.sh/your-long-random-topic
ALERT_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
